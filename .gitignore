# Generated by the compiler to run a decorator (spec 455): an artifact of a
# build, not source.
.lumen-decorator-*.ts
sio-demo
echo-server
ws-client-demo
tprobe
api
.env
node_modules
dist
indexer
test-results/
playwright-report/
tkg
mig

# Compiled engine binaries. `api` is already ignored above; its dated backups
# are the same artifact — `lumen compile` cannot overwrite a running binary, so
# the deploy loop moves the old one aside as api.prev-<stamp> and each is
# 40-60MB of build output.
# Every set-aside copy of the engine binary, whatever the deploy loop called
# it that day — prev-, stage-, anything. One pattern, so the next name is
# covered too; api.stage-* reached a push at 60MB because the rule named
# only prev-.
/packages/agents/api.[a-z]*-*
/packages/agents/indexer
# Stray compiler output from a bare `lumen compile` in the repo root.
/unk
/unk2

# Built engine binaries and their rollbacks: 50MB+ each, produced by
# `lumen compile`, never a source of truth.
packages/agents/api
packages/agents/api.*
packages/agents/scheduler
packages/agents/scheduler.*
!packages/agents/api.ts
!packages/agents/api.test.ts
!packages/agents/scheduler.ts
# Compiled SCRIPT steps, keyed by the hash of their source and rebuilt on
# demand — a cache, not code.
packages/agents/script-cache/
*.wasm

# A copy of a secrets file is a secrets file. `.env` is ignored above, and
# `.env.bak-pre-envs` was not — this repository is public, so that one file
# would have published the master key and the database password to anyone who
# cared to look. Ignored by shape rather than by name, because the next copy
# will be called something else.
.env.bak*
.env.*.bak
*.env.bak*

# Scratch copies kept beside a file while it is being rewritten
# (discover.ts.bak-showbiz and friends). Never source.
*.ts.bak-*
*.ts.bak
probe_hours
