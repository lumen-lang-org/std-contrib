{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    // `vite/client` for `import.meta.env` (pages/index.ts and pages/auth/
    // _form.ts read the SSR flag); `node` for the proxy's node:http. Naming
    // any type package at all turns off the automatic inclusion of every
    // @types/* in node_modules, so both have to be listed once one is.
    //
    // Vite is no longer a direct dependency — phase 5 removed the second
    // server — but it is still the bundler underneath: @nuraly/lumenjs
    // depends on it, `lumenjs dev` is a Vite server and `lumenjs build` is a
    // Vite build. `import.meta.env` is Vite's, so its types are the right
    // ones to name here, and they resolve through the framework.
    "types": ["vite/client", "node"],
    "noEmit": true
  },
  "include": ["src", "pages", "server"]
}
