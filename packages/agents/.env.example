# The master key: 32 hex characters. It encrypts every provider credential in
# the database; losing it means re-entering every key, and committing it means
# rotating every key. Generate one:
#   openssl rand -hex 16
LUMEN_MASTER_KEY=

# The database password inside the compose network.
AGENTS_PG_PASSWORD=agents

# Whether a proxy in front of this process may say who is calling, by setting
# an X-USER header. Off — anything but 1/true/yes/on — and the header is not
# read at all: no owner is known, no filter is applied, and the engine behaves
# exactly as it did before it had owners.
#
# On, every thread, file, artifact, step and run is scoped to the tag the proxy
# named, and :8100 MUST NOT be reachable by anything but that proxy: the header
# is then the whole of the identity, and whoever can send one chooses it.
# Firewall first, turn this on second. See GATEWAY.md.
AGENTS_TRUST_PROXY_AUTH=off

# A bearer token every route but /healthz must present. Unset — the default —
# nothing is asked for, which is what every deployment has run so far.
#
# Defense in depth behind the firewall, not instead of it: with the trust gate
# on, whoever reaches :8100 chooses who they are, and firewall-only means one
# missed rule is the whole breach. The proxy in front sends it.
#
# The unit reads this file with `export $(grep -v "^#" .env | xargs)`, which
# breaks on spaces and quotes — so generate a value with none:
#   openssl rand -base64 32 | tr -dc A-Za-z0-9_-
AGENTS_API_TOKEN=

# The byte ceilings, each defaulting to the number it was when it was a
# compile-time constant. Anything unreadable — "512MB", "0" — is the default,
# so a typo here leaves the engine at its documented limit rather than dead.
AGENTS_ARTIFACT_BYTES_MAX=524288
AGENTS_THREAD_BYTES_MAX=104857600
AGENTS_UPLOAD_BYTES_MAX=1048576

# How long a thread that holds nothing at all — no turn, no artifact, no step,
# no uploaded file, no run — may sit before a background pass deletes the row.
# The same number is how long that pass waits between rounds. 3600000 is an
# hour.
#
# Unset or unreadable — the default — nothing is ever deleted and the pass is
# not started. This engine has never collected abandoned opens, so turning it
# on is a policy an operator chooses, not an upgrade that starts removing rows
# on a box nobody is watching.
AGENTS_SWEEP_IDLE_MS=
